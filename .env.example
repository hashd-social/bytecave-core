# Environment
NODE_ENV=production

# Server Configuration
NODE_ID=vault-node-1
PORT=3004
NODE_URL=http://localhost:3004

# Blockchain Configuration (Hardhat Account #1)
RPC_URL=http://127.0.0.1:8545
OWNER_ADDRESS=
PRIVATE_KEY=

# ⚠️  AUTO-REGISTRATION ON-CHAIN ⚠️
# WARNING: Setting this to 'true' will automatically register this node on-chain when it starts
# This will:
# - Stake 1000 HASHD tokens from the wallet associated with PRIVATE_KEY
# - Register the node's peer ID and public key on the VaultNodeRegistry contract
# - Require the wallet to have at least 1000 HASHD tokens
# Setting to 'false' will deregister the node on startup (returns staked tokens)
# Comment out completely to skip auto-registration or de-registration!
# REGISTER_ON_CHAIN=

# Token Contracts
HASHD_TOKEN_ADDRESS=0x67d269191c92Caf3cD7723F116c85e6E9bf55933

# Vault Registry (deployed contracts)
VAULT_REGISTRY_ADDRESS=0x1613beB3B2C4f22Ee086B2b38C1476A3cE7f78E8

# Vault Incentives (optional - for rewards)
VAULT_INCENTIVES_ADDRESS=

# Garbage Collection
GC_ENABLED=true
GC_RETENTION_MODE=hybrid
GC_MAX_STORAGE_MB=5000
GC_MAX_BLOB_AGE_DAYS=30
GC_MIN_FREE_DISK_MB=1000
GC_RESERVED_FOR_PINNED_MB=1000
GC_INTERVAL_MINUTES=10
GC_VERIFY_REPLICAS=false
GC_VERIFY_PROOFS=false

# Sharding
SHARD_COUNT=1024
NODE_SHARDS=[{"start":0,"end":1023}]

# Storage Configuration
# DATA_DIR is the base directory - a subfolder with NODE_ID will be created automatically
# Example: DATA_DIR=./data with NODE_ID=bat-alpha creates ./data/bat-alpha
DATA_DIR=./data
MAX_BLOB_SIZE_MB=10
MAX_STORAGE_GB=100

# Replication Configuration
REPLICATION_ENABLED=true
REPLICATION_TIMEOUT_MS=5000
REPLICATION_FACTOR=3

# Security
ENABLE_BLOCKED_CONTENT=true

# App Registration & Filtering
# ALLOWED_APPS: Comma-separated list of app names this node accepts (default: hashd)
# Empty = accept all registered apps, '*' = wildcard accept all
ALLOWED_APPS=hashd
# REQUIRE_APP_REGISTRY: Enforce AppRegistry validation (default: true)
# Set to false for signature-based authorization (numerical sharding)
REQUIRE_APP_REGISTRY=false

# Performance
CACHE_SIZE_MB=50
COMPRESSION_ENABLED=false

# Monitoring
METRICS_ENABLED=true
LOG_LEVEL=info

# CORS
CORS_ORIGIN=

# P2P Configuration
# NOTE: P2P settings are now persisted in data/config.json
# Environment variables here are used as defaults/overrides
# Discovered peers are automatically saved to config.json for reconnection on restart

# P2P Listen Addresses - nodes use 6001/6002, relay uses 4001/4002
P2P_LISTEN_ADDRESSES=/ip4/0.0.0.0/tcp/6001,/ip4/0.0.0.0/tcp/6002/ws

# P2P Bootstrap Peers (for cross-network discovery)
# Leave empty to use peers from config.json
P2P_BOOTSTRAP_PEERS=

# P2P Relay Peers (Docker relay - use 127.0.0.1 for localhost access)
# This is used by bytecave-core when running as a standalone vault node
# For bytecave-desktop, relay peers are passed via BYTENODE_RELAY_PEERS
# Update this with the actual peer ID from: docker logs bytecave-relay
# Leave empty to use peers from config.json
P2P_RELAY_PEERS=/ip4/127.0.0.1/tcp/4002/ws/p2p/12D3KooWDUsTtqKh7VcnydpAe5G8SwiMKYramFny6caML58zbg9Y
APP_REGISTRY_ADDRESS=
CONTENT_REGISTRY_ADDRESS=
CONTENT_REGISTRY_STORAGE_ADDRESS=
